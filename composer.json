{
    "name": "do1emu/module-news",
    "description": "Neuigkeiten-Modul für die modulare Intranet-Plattform: https://github.com/kleinebekele/intranet-core",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "intranet", "modul", "news"],
    "authors": [
        {
            "name": "do1emu"
        }
    ],
    "require": {
        "php": "^8.3"
    },
    "autoload": {
        "psr-4": {
            "Intranet\\Modules\\News\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Intranet\\Modules\\News\\NewsServiceProvider"
            ]
        }
    }
}
